# EduDSS Environment Configuration Template
# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env (đã có trong .gitignore).
# Tệp mẫu này không chứa bí mật: mọi khoá/mật khẩu để trống.
# Biến nào để trống hoặc bị comment thì ứng dụng dùng giá trị mặc định an toàn.

# Môi trường: development | test | production. KHÔNG đặt = production (không tạo tài khoản demo,
# không dữ liệu mô phỏng). Chạy thử trên máy thì để development.
EDUDSS_ENV=development

# Deployment Mode: 'DEMO_SYNTHETIC' or 'REAL_LMS' or 'LOCAL_OFFLINE'
EDUDSS_MODE=DEMO_SYNTHETIC

# AI / LLM Provider Keys (Optional for Cloud Providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Local LLM Gateway / Ollama
# Cài Ollama (https://ollama.com/download) rồi: ollama pull qwen2.5:7b
# App chạy trong Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b      # mặc định tự chọn model đã cài
# OLLAMA_API_KEY=              # chỉ cần cho Ollama Cloud (https://ollama.com)
# Thời gian chờ tối đa (giây) cho mỗi lần gọi AI cloud trước khi chuyển model dự phòng
DSS_LLM_TIMEOUT=60
# Số dòng train từ đó dùng lưới tham số gọn + 3 fold CV (nhanh, cùng độ chính xác)
# DSS_LARGE_DATA_ROWS=10000
DSS_PRIMARY_PROVIDER=local_ollama
DSS_FALLBACK_1=groq
DSS_FALLBACK_2=gemini

# Model Customization (Tùy chọn: tự do chỉ định tên model mới nhất mà không cần sửa code)
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

# Database (PostgreSQL + pgvector — Phase 1, dss/db/). OPTIONAL in this phase:
# the app runs fine on its existing JSON/joblib storage with none of this set.
# Set either DATABASE_URL (takes priority) OR all of DB_HOST/DB_NAME/DB_USER
# below. See dss/db/session.py for the exact resolution order — never hard-code
# credentials in code; this file is a template only, never commit the real .env.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/edudss_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edudss_db
DB_USER=postgres
DB_PASSWORD=

# Structured learning plan history: production requires postgres; no local fallback.
EDUDSS_LEARNING_PLANS_STORE=local
# Optional administrator mapping for a dedicated single-course pilot.
EDUDSS_COURSE_ID=

# Classroom/programme platform: local SQLite in development; production requires postgres.
EDUDSS_PLATFORM_STORE=local
# Managed school deployments require an active programme allocation before new writes.
EDUDSS_REQUIRE_PROGRAM_ALLOCATION=0
# Server-side school identity; never set from a request or a role selector.
EDUDSS_ORGANIZATION_ID=1
EDUDSS_ORGANIZATION_NAME=


# Optional queued AI engine; a nonempty URL switches the AI page to this service.
# Share this server-only signing key with engine/.env; at least 32 random bytes.
# Provision classes/enrollments first, then train engine data under the SAME
# EDUDSS_ORGANIZATION_ID and course/student codes. No automatic demo-ID remapping.
EDUDSS_ENGINE_URL=
EDUDSS_ENGINE_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Các biến dưới đây đều TUỲ CHỌN (mặc định nằm trong mã). Bỏ comment khi cần.
# ---------------------------------------------------------------------------

# Thư mục dữ liệu runtime (mô hình, kho dữ liệu, nhật ký). Mặc định ./data_warehouse
# EDUDSS_DATA_ROOT=
# Mức log: DEBUG | INFO | WARNING
# DSS_LOG_LEVEL=INFO

# --- Đăng nhập & tài khoản ---
# Bản demo công khai: tắt mọi tài khoản/lối tắt demo (1 = bật)
# EDUDSS_PUBLIC_DEMO=0
# Hiện hộp "tài khoản dùng thử" ở trang đăng nhập (chỉ ngoài production)
# EDUDSS_SHOW_DEMO_CREDENTIALS=0
# Tự tạo tài khoản sinh viên ở lần đăng nhập đầu (chỉ ngoài production)
# EDUDSS_ALLOW_STUDENT_AUTOPROVISION=
# Admin đầu tiên (tạo một lần khi khởi động; mật khẩu >= 12 ký tự)
# EDUDSS_BOOTSTRAP_ADMIN_USER=admin
# EDUDSS_BOOTSTRAP_ADMIN_PASSWORD=
# EDUDSS_BOOTSTRAP_ADMIN_EMAIL=
# Google Sign-In. Redirect URI: <EDUDSS_PUBLIC_URL>/oauth2callback
# EDUDSS_PUBLIC_URL=
# EDUDSS_GOOGLE_CLIENT_ID=
# EDUDSS_GOOGLE_CLIENT_SECRET=
# EDUDSS_GOOGLE_SELF_SIGNUP=0
# Ký cookie phiên Google. Sinh: openssl rand -hex 32
# EDUDSS_AUTH_COOKIE_SECRET=
# Sau reverse proxy GHI ĐÈ header IP (Caddy/Nginx), VD X-Real-IP
# EDUDSS_CLIENT_IP_HEADER=
# Danh tính lưu ở: local | postgres (production: postgres)
# EDUDSS_IDENTITY_STORE=local

# --- Quyền riêng tư & ký số (BẮT BUỘC ở production, >= 32 byte ngẫu nhiên) ---
# EDUDSS_PSEUDONYM_KEY=
# EDUDSS_PSEUDONYM_KEY_VERSION=1
# EDUDSS_ARTIFACT_SIGNING_KEY=

# --- AI ---
# Tên khác cho khoá Gemini / Hugging Face
# GOOGLE_API_KEY=
# HUGGINGFACE_TOKEN=
# HF_API_KEY=
# Model Hugging Face chạy cục bộ
# DSS_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Mô hình embedding cho RAG
# EDUDSS_EMBEDDING_MODEL=
# Bộ phân loại an toàn cho câu hỏi gửi AI (0 = tắt)
# EDUDSS_SAFETY_CLASSIFIER=1
# Giới hạn độ dài prompt gửi AI
# EDUDSS_MAX_AI_PROMPT_CHARS=
# Bảng giá token tuỳ chỉnh (JSON)
# EDUDSS_LLM_PRICING_JSON=

# --- Vector store ---
# PGVECTOR_URL=
# EDUDSS_REQUIRE_PGVECTOR=0

# --- Tải tệp lên ---
# EDUDSS_MAX_UPLOAD_MB=
# EDUDSS_MAX_UPLOAD_ROWS=
# EDUDSS_MAX_UPLOAD_COLUMNS=

# --- Tích hợp LMS ---
# Khoá HMAC xác thực webhook LMS. Để trống = mọi webhook bị từ chối.
# EDUDSS_LMS_WEBHOOK_SECRET=
# EDUDSS_MOODLE_URL=
# EDUDSS_MOODLE_TOKEN=
# Token LMS của từng trường được tham chiếu theo TÊN biến, VD EDUDSS_LMS_TOKEN_<MA_TRUONG>

# --- Vận hành: health, metrics, pipeline, backup ---
# EDUDSS_HEALTH_PORT=8081
# Bearer token cho /metrics. Sinh: openssl rand -hex 24
# EDUDSS_METRICS_TOKEN=
# EDUDSS_METRICS_CACHE_SECONDS=
# EDUDSS_READINESS_CACHE_SECONDS=
# EDUDSS_PIPELINE_DAILY_AT=19:30
# EDUDSS_BACKUP_DIR=
# EDUDSS_BACKUP_KEEP_DAYS=7
# EDUDSS_DEMO_STUDENT_POOL=1000

# --- Chỉ dùng khi phát triển ---
# EDUDSS_PERF_DEBUG=0
# EDUDSS_PROFILE_DIR=
