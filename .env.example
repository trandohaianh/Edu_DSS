# EduDSS Environment Configuration Template
# Copy this file to .env and provide your actual API keys.
# NEVER commit .env to version control.

# Deployment Mode: 'DEMO_SYNTHETIC' or 'REAL_LMS' or 'LOCAL_OFFLINE'
EDUDSS_MODE=DEMO_SYNTHETIC

# Secret Key for Session Encryption
SECRET_KEY=change-me-to-a-secure-random-string

# AI / LLM Provider Keys (Optional for Cloud Providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Local LLM Gateway / Ollama
# Cài Ollama (https://ollama.com/download) rồi: ollama pull qwen2.5:7b
# App chạy trong Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b      # mặc định tự chọn model đã cài
# OLLAMA_API_KEY=              # chỉ cần cho Ollama Cloud (https://ollama.com)
# Thời gian chờ tối đa (giây) cho mỗi lần gọi AI cloud trước khi chuyển model dự phòng
DSS_LLM_TIMEOUT=60
# Số dòng train từ đó dùng lưới tham số gọn + 3 fold CV (nhanh, cùng độ chính xác)
# DSS_LARGE_DATA_ROWS=10000
DSS_PRIMARY_PROVIDER=local_ollama
DSS_FALLBACK_1=groq
DSS_FALLBACK_2=gemini

# Model Customization (Tùy chọn: tự do chỉ định tên model mới nhất mà không cần sửa code)
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

# Database (PostgreSQL + pgvector — Phase 1, dss/db/). OPTIONAL in this phase:
# the app runs fine on its existing JSON/joblib storage with none of this set.
# Set either DATABASE_URL (takes priority) OR all of DB_HOST/DB_NAME/DB_USER
# below. See dss/db/session.py for the exact resolution order — never hard-code
# credentials in code; this file is a template only, never commit the real .env.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/edudss_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edudss_db
DB_USER=postgres
DB_PASSWORD=
