# Sao chép thành .env (setup.sh làm việc này và tự sinh các bí mật). KHÔNG commit .env.

# Tên miền DuckDNS trỏ về IP của VM, VD edudss-demo.duckdns.org
EDUDSS_DOMAIN=
# = https://<EDUDSS_DOMAIN> (dùng làm redirect URI của Google: <url>/oauth2callback)
EDUDSS_PUBLIC_URL=

# Google Sign-In: OAuth client loại "Web application" (dùng chung client với FieldOps được).
# Authorized redirect URI: https://<EDUDSS_DOMAIN>/oauth2callback
EDUDSS_GOOGLE_CLIENT_ID=
EDUDSS_GOOGLE_CLIENT_SECRET=
# Tự sinh: ký cookie phiên đăng nhập Google của Streamlit
EDUDSS_AUTH_COOKIE_SECRET=

# Tài khoản Admin đầu tiên (tạo một lần lúc khởi động; mật khẩu >= 12 ký tự, tự sinh)
EDUDSS_BOOTSTRAP_ADMIN_USER=admin
EDUDSS_BOOTSTRAP_ADMIN_PASSWORD=
# Email Google của bạn -> đăng nhập Admin bằng Google
EDUDSS_BOOTSTRAP_ADMIN_EMAIL=

# Prometheus / Grafana Cloud: Bearer token cho https://<domain>/metrics (tự sinh)
EDUDSS_METRICS_TOKEN=

# AI (tuỳ chọn). Trống = trợ lý AI dùng câu trả lời mẫu có gắn nhãn rõ ràng.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Pipeline: giờ chạy tác vụ hằng ngày (UTC; 19:30 UTC = 02:30 giờ VN), số ngày giữ backup
EDUDSS_PIPELINE_DAILY_AT=19:30
EDUDSS_BACKUP_KEEP_DAYS=7
# Số sinh viên mô phỏng có thể cấp cho người đăng nhập Google
EDUDSS_DEMO_STUDENT_POOL=1000
