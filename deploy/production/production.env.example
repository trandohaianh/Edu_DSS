# EduDSS dedicated production deployment — environment TEMPLATE.
# Copy to production.env (git-ignored: deploy/**/*.env), fill every value and restrict
# permissions (chmod 600). Never commit real values.

# --- Identity of this deployment ---
EDUDSS_DOMAIN=
EDUDSS_ORGANIZATION_ID=
# Immutable artifact from the release pipeline (digest, never a mutable tag):
# EDUDSS_IMAGE=ghcr.io/<org>/edudss@sha256:<digest>
EDUDSS_IMAGE=
EDUDSS_MODE=REAL_LMS

# --- PostgreSQL (owner role migrates; app role is non-superuser so RLS applies) ---
DB_NAME=edudss
DB_OWNER_USER=edudss_owner
DB_OWNER_PASSWORD=
DB_APP_USER=edudss_app
DB_APP_PASSWORD=

# --- Privacy: keyed pseudonymization (REQUIRED in production) ---
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Rotation: set a NEW key and increment the version; see C1_1_SECURITY_PRIVACY_HARDENING.md.
EDUDSS_PSEUDONYM_KEY=
EDUDSS_PSEUDONYM_KEY_VERSION=1

# --- Optional external AI providers (leave empty for "no external AI") ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
