# EduDSS — triển khai độc lập có HTTPS riêng (deploy/standalone).
# Sao chép thành .env rồi điền. KHÔNG commit .env. Tệp này không chứa bí mật thật.

# Tên dự án docker compose (container, volume, network đều mang tiền tố này).
COMPOSE_PROJECT_NAME=edudss-standalone

# --- HTTPS (Caddy) ---
# Tên miền công khai trỏ (bản ghi A/AAAA) về IP máy chủ, VD edudss.example.edu.vn.
# Thử trên máy cá nhân: dùng edudss.localhost (Caddy tự cấp chứng chỉ nội bộ).
APP_DOMAIN=edudss.localhost
# Email nhận thông báo hết hạn chứng chỉ từ Let's Encrypt (bắt buộc).
ACME_EMAIL=
# Cổng host. Production phải là 80/443 để ACME HTTP-01/TLS-ALPN-01 chạy được.
HTTP_PORT=80
HTTPS_PORT=443

# --- Image ---
# Để trống: build từ Dockerfile ở gốc repo thành edudss:standalone.
# Hoặc trỏ tới image đã build/ký sẵn, VD ghcr.io/<org>/edudss@sha256:<digest>.
EDUDSS_IMAGE=edudss:standalone
EDUDSS_GIT_SHA=unknown

# --- Ứng dụng (dữ liệu MÔ PHỎNG) ---
# = https://<APP_DOMAIN>; dùng làm redirect URI Google: <url>/oauth2callback
EDUDSS_PUBLIC_URL=
# Google Sign-In (tuỳ chọn). Authorized redirect URI: https://<APP_DOMAIN>/oauth2callback
EDUDSS_GOOGLE_CLIENT_ID=
EDUDSS_GOOGLE_CLIENT_SECRET=
# Ký cookie phiên đăng nhập Google. Sinh bằng: openssl rand -hex 32
EDUDSS_AUTH_COOKIE_SECRET=
# Tài khoản Admin đầu tiên (mật khẩu >= 12 ký tự). Sinh bằng: openssl rand -hex 12
EDUDSS_BOOTSTRAP_ADMIN_USER=admin
EDUDSS_BOOTSTRAP_ADMIN_PASSWORD=
EDUDSS_BOOTSTRAP_ADMIN_EMAIL=
# Bearer token cho https://<APP_DOMAIN>/metrics. Sinh bằng: openssl rand -hex 24
EDUDSS_METRICS_TOKEN=
# AI (tuỳ chọn). Để trống = trợ lý dùng câu trả lời mẫu có gắn nhãn.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
